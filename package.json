{
  "name": "@myko.pk/response",
  "version": "1.0.0",
  "description": "Shared response utilities, builders, and exception filters for MYKO services",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./builders": {
      "import": {
        "types": "./dist/builders/response.builder.d.ts",
        "default": "./dist/builders/response.builder.js"
      },
      "require": {
        "types": "./dist/builders/response.builder.d.ts",
        "default": "./dist/builders/response.builder.cjs"
      }
    },
    "./filters": {
      "import": {
        "types": "./dist/filters/index.d.ts",
        "default": "./dist/filters/index.js"
      },
      "require": {
        "types": "./dist/filters/index.d.ts",
        "default": "./dist/filters/index.cjs"
      }
    }
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && cp -r views dist/views",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "class-transformer": "^0.5.0",
    "class-validator": "^0.14.0",
    "express": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/swagger": {
      "optional": true
    },
    "class-transformer": {
      "optional": true
    },
    "class-validator": {
      "optional": true
    }
  },
  "dependencies": {
    "@myko.pk/logger": "*",
    "rxjs": "^7.0.0"
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@types/express": "^5.0.6",
    "class-transformer": "^0.5.0",
    "class-validator": "^0.14.0",
    "express": "^4.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mykopk/response.git"
  },
  "bugs": {
    "url": "https://github.com/mykopk/response/issues"
  },
  "homepage": "https://www.npmjs.com/package/@myko.pk/response"
}
